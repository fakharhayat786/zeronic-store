# Copy these values into your shell or hosting dashboard as environment
# variables. This project does NOT auto-load a .env file — setting the
# variables is required for the admin dashboard to work.
#
# Port the server listens on (hosting providers usually set this for you).
PORT=3000
#
# Admin dashboard password. REQUIRED to use /admin. Choose a strong password
# and never commit the real value to git. Example only — change it:
ADMIN_PASSWORD=change-me-to-a-strong-password
